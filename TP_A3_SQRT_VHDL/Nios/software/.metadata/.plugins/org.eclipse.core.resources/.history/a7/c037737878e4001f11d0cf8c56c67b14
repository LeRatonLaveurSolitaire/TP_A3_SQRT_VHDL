/*
 * "Hello World" example.
 *
 * This example prints 'Hello from Nios II' to the STDOUT stream. It runs on
 * the Nios II 'standard', 'full_featured', 'fast', and 'low_cost' example
 * designs. It runs with or without the MicroC/OS-II RTOS and requires a STDOUT
 * device in your system's hardware.
 * The memory footprint of this hosted application is ~69 kbytes by default
 * using the standard reference design.
 *
 * For a reduced footprint version of this template, and an explanation of how
 * to reduce the memory footprint for a given application, see the
 * "small_hello_world" template.
 *
 */

#include <stddef.h>
#include <stdio.h>
#include "sys/alt_timestamp.h"
#include "alt_types.h"

#define N 16
#define GET_TIME (*snapl&0x0000FFFF)+((*snaph<<16)&0xFFFF0000)

unsigned int sqrt(unsigned int A) {
	unsigned int D = A;
	int R = 0;
	unsigned int Z = 0;
	char i;

	for (i = N - 1; i >= 0; i--) {
		if (R >= 0) {
			R = (R << 2) + (D >> (2*N -2)) - ((Z << 2) + 1);
		}
		else {
			R = (R << 2) + (D >> (2*N -2)) + ((Z << 2) + 3);
		}
		if (R >= 0) {
			Z = (Z << 1) + 1;
		}
		else {
			Z = (Z << 1);
		}
		D = D << 2;
	}
	return Z;
}



int main()
{
  printf("Hello from Nios II!\n");

  unsigned int listA[5] = {0, 1, 512, 1194877489, 4294967295};
  unsigned int tabInt[200];
  int i = 0;
  int j = 0;

  for (i = 0; i < 200; i++) {
	  tabInt[i] = 0;
	  for (j = 0; j < i; j++) {
		  tabInt[i] += i;
	  }
  }

  alt_u32 t1, t2;

  alt_timestamp_start();

  //int *snapl = TIMER_BASE + 4 + (0x00000001 << 32);
  int *snapl = 0x81109010;
  //int *snaph = TIMER_BASE + 5*4 + (0x00000001 << 32);
  int *snaph = 0x81109014;

  (*snapl) = 1;

  unsigned int start = GET_TIME;
  (*snapl) = 0xFFFFFFFF;
  int h = 0;
  for (h=0; h<800; h++);
  unsigned int end = GET_TIME;
  t1 = alt_timestamp();
  t2 = alt_timestamp();

  printf("Contenu timer %d, start %u, end %u \n", (start - end >= 0) ? start - end : (start + 0xFFFFFFFF - end), start, end);
  printf("Contenu altera timer %d, t1 %u, t2 %u \n", (t2 - t1 >= 0) ? (t2 - t1) : (t2 + (4294967295 - t1)), t1, t2);

  unsigned int result;
  i = 0;

  for (i = 0; i < 5; i++) {
	  printf(" A = %u \n", listA[i]);
	  t1 = alt_timestamp();
	  result = sqrt(listA[i]);
	  t2 = alt_timestamp();

	  printf(" sqrt(A) = %d, time : %d, t1 : %d, t2 : %d \n", result, (t2 - t1 > 0) ? (t2 - t1) : (t2 + (4294967295 - t1)), t1, t2);
  }

  return 0;
}
