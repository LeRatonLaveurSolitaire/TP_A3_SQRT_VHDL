#include <stddef.h>
#include <stdio.h>
#include "sys/alt_timestamp.h"
#include "alt_types.h"

#define N 16
#define GET_TIME *snapl&0xFFFF+(*snaph<<16)&0xFFFF0000

unsigned int sqrt(unsigned int A) {
	unsigned int D = A;
	int R = 0;
	unsigned int Z = 0;
	char i;

	for (i = N - 1; i >= 0; i--) {
		if (R >= 0) {
			R = (R << 2) + (D >> (2*N -2)) - ((Z << 2) + 1);
		}
		else {
			R = (R << 2) + (D >> (2*N -2)) + ((Z << 2) + 3);
		}
		if (R >= 0) {
			Z = (Z << 1) + 1;
		}
		else {
			Z = (Z << 1);
		}
		D = D << 2;
	}
	return Z;
}



