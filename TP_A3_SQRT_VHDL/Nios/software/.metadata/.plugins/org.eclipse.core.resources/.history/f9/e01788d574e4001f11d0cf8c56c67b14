  t2 = alt_timestamp();

  printf("Contenu timer %d \n ", (start - end > 0) ? start - end : (start + 0xFFFFFFFE - end));
  printf("Contenu altera timer %d \n "

  unsigned int result;
  int i = 0;

  for (i = 0; i < 5; i++) {
	  printf(" A = %u \n", listA[i]);
	  t1 = alt_timestamp();
	  result = sqrt(listA[i]);
	  t2 = alt_timestamp();

	  printf(" sqrt(A) = %d, time : %d, t1 : %d, t2 : %d \n", result, (t2 - t1 > 0) ? (t2 - t1) : (t2 + (4294967295 - t1)), t1, t2);
  }

  return 0;
}
