 * "small_hello_world" template.
 *
 */

#include <stdio.h>

#define N 32

unsigned long sqrt(unsigned long long A) {
	unsigned long long D = A;
	long long R = 0;
	unsigned long Z = 0;
	char i;

	for (i = N - 1; i >= 0; i--) {
		if (R >= 0) {
			R = (R << 2) + (D >> 2*N -2) - (Z << 2 + 1);
		}
		else {
			R = (R << 2) + (D >> 2*N -2) + (Z << 2 + 3);
		}
		if (R >= 0) {
			Z = (Z << 1) + 1;
		}
		else {
			Z = Z << 1;
		}
		D = D << 2;
	}
	return Z;
}


int main()
{
  printf("Hello from Nios II!\n");

  unsigned long long *listA[5] = {0, 1, 512, 1194877489, 4294967295};

  unsigned long result;

  for (int i = 0; i < 5; i++) {
	  printf(" A = %d \n", listA[i]);
	  result = sqrt(listA[i]);
	  printf(" sqrt(A) = %d \n", result);
  }

  return 0;
}
